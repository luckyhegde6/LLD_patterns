{
  "name": "lld-patterns-typescript-tests",
  "private": true,
  "scripts": {
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "roots": [
      "<rootDir>/Typescript"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/test/**/*.test.ts"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "target": "ES2020",
            "module": "commonjs",
            "esModuleInterop": true,
            "strict": false
          }
        }
      ]
    }
  }
}
